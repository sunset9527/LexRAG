DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ZHIPUAI_API_KEY=your_zhipuai_api_key_here
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Runtime mode. Production startup rejects unsafe secrets, open registration,
# insecure cookies, or a missing trusted-provider allowlist.
APP_MODE=development
OPEN_REGISTRATION=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Database (v1.7+)
# 留空使用 SQLite 开发模式；生产环境填写 PostgreSQL 连接串
# DATABASE_URL=postgresql://user:password@localhost:5432/lexrag

# JWT (v1.7+)
# 生产环境必须覆盖此密钥！
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production

# Explicit administrator bootstrap (used by scripts/bootstrap_admin.py).
# Set these only in the process environment; never commit real values.
LEXRAG_BOOTSTRAP_USERNAME=
LEXRAG_BOOTSTRAP_PASSWORD=
LEXRAG_BOOTSTRAP_ORGANIZATION=default

# Upload / Worker ceilings
UPLOAD_MAX_BYTES=20971520
UPLOAD_BATCH_MAX_BYTES=52428800
UPLOAD_BATCH_MAX_FILES=10
UPLOAD_MAX_PDF_PAGES=500
UPLOAD_MAX_EXTRACTED_CHARACTERS=2000000
DOCUMENT_TASK_SOFT_TIME_LIMIT_SECONDS=900
DOCUMENT_TASK_TIME_LIMIT_SECONDS=960

# Runtime LLM allowlist and resource ceilings
RUNTIME_LLM_TRUSTED_BASE_URLS=https://api.deepseek.com,https://dashscope.aliyuncs.com/compatible-mode/v1,https://open.bigmodel.cn/api/paas/v4,https://api.openai.com/v1,https://api.anthropic.com
RUNTIME_LLM_TIMEOUT_SECONDS=90
RUNTIME_LLM_MAX_OUTPUT_TOKENS=4096
RUNTIME_LLM_MAX_RETRIES=2
RUNTIME_LLM_MAX_CONCURRENCY=8

# Langfuse (v1.7+)
# 不配置则自动禁用（不会报错）
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
