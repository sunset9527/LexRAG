# Copy to .env.docker and fill every blank before starting compose.yaml.
# Keep .env.docker out of Git.  Password values used in DATABASE_URL must be
# URL-safe (or percent-encoded) because Compose passes the full URL to Python.

MYSQL_DATABASE=lexrag
MYSQL_APP_USER=lexrag
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
JWT_SECRET_KEY=

# Host path to the local BGE-M3 directory.  Compose mounts it read-only at
# /models/bge-m3; it does not download a model or silently use a remote API.
LEXRAG_LOCAL_EMBEDDING_MODEL_PATH=

# Only the Nginx web service is published.  MySQL, Redis, and the API remain
# on the private Compose network.
LEXRAG_WEB_PORT=8080

# This allowlist is non-secret.  A query still needs an explicit runtime key.
RUNTIME_LLM_TRUSTED_BASE_URLS=https://api.deepseek.com
